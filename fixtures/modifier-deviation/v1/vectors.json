{
  "version": "v1",
  "description": "Vectores de conformidad del EFECTO DE INVENTARIO de un modificador (R28). Los MISMOS vectores se ejecutan contra el resolutor del terminal (apps/pos_app/lib/domain/usecases/inventory/modifier_deviation_resolver.dart) y contra el espejo de la nube (apps/admin_backend/src/modules/inventory/modifier-deviation-resolver.ts). Si un lado cambia su semántica sin el otro, uno de los dos deja de pasar: esta es la guarda que impide que la demanda que recalcula la nube y la que envía el terminal diverjan. Es la +1 que hace que la comparación de M4 signifique algo.",
  "semantics": {
    "ADD": "suma un insumo a la demanda; la cantidad se hereda del componente objetivo salvo que el operador la marque",
    "REMOVE": "el componente de la receta deja de consumirse",
    "SWAP": "el componente de la receta se repone y el insumo sustituto se descuenta en su cantidad",
    "SCALE": "el componente de la receta se multiplica por el factor",
    "skipReasons": {
      "INSUMSO_NOT_IN_CATALOG": "la empresa no tiene registrado (o tiene desactivado) el insumo: el efecto no aplica (garantía de SOHO, D6)",
      "UNIT_MISMATCH": "la cantidad heredada pertenece a otra unidad: el operador debe marcarla",
      "COMPONENT_NOT_IN_RECIPE": "la receta no tiene ese componente",
      "INCOMPLETE": "el efecto no declara lo que necesita"
    }
  },
  "cases": [
    {
      "name": "add inherits the recipe quantity (D2)",
      "leaves": [
        {
          "insumoId": "ins-cafe",
          "quantityPerSaleUnit": 18,
          "rootComponentId": "cmp-cafe"
        },
        {
          "insumoId": "ins-leche",
          "quantityPerSaleUnit": 150,
          "rootComponentId": "cmp-leche"
        }
      ],
      "rootComponents": [
        {
          "id": "cmp-cafe",
          "insumoId": "ins-cafe",
          "quantityPerSaleUnit": 18
        },
        {
          "id": "cmp-leche",
          "insumoId": "ins-leche",
          "quantityPerSaleUnit": 150
        }
      ],
      "tenantInsumos": [
        {
          "id": "ins-cafe",
          "consumptionUom": "G",
          "isActive": true
        },
        {
          "id": "ins-leche",
          "consumptionUom": "ML",
          "isActive": true
        }
      ],
      "modifiers": [
        {
          "optionId": "opt-shot",
          "inventoryEffect": "ADD",
          "effectInsumoId": "ins-cafe",
          "effectTargetInsumoId": "ins-cafe"
        }
      ],
      "expectedDemand": {
        "ins-cafe": 36,
        "ins-leche": 150
      },
      "expectedOutcomes": [
        {
          "optionId": "opt-shot",
          "effect": "ADD",
          "applied": true
        }
      ]
    },
