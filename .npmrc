# Security: Block lifecycle scripts to prevent supply chain attacks
# (Shai-Hulud, ChainDrop, Miasma campaigns exploit preinstall hooks)
ignore-scripts=true

# Security: Only install versions published more than 7 days ago
# pnpm value is in minutes (7 days = 10080 minutes)
minimum-release-age=10080

# Enable strict SSL for registry connections
strict-ssl=true

# Only allow install from official npm registry
registry=https://registry.npmjs.org/
