{
  "name": "showcase_video",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "remotion preview src/index.ts",
    "preview": "remotion preview src/index.ts",
    "build": "remotion render src/index.ts ShowcaseMaster out/showcase-master.mp4",
    "build:metrics": "remotion render src/index.ts MetricsShowcase out/nhilos_pos_metricas_convenios.mp4",
    "build:reel": "remotion render src/index.ts SocialReel out/social-reel.mp4",
    "build:speed": "remotion render src/index.ts SpeedReel out/nhilos_pos_velocidad_mostrador.mp4",
    "build:fiscal": "remotion render src/index.ts FiscalReel out/nhilos_pos_certeza_fiscal_dgi.mp4",
    "build:offline": "remotion render src/index.ts OfflineReel out/nhilos_pos_continuidad_offline.mp4",
    "build:blind": "remotion render src/index.ts BlindAuditReel out/nhilos_pos_cierre_arqueo_ciego.mp4",
    "build:hold": "remotion render src/index.ts HoldOrdersReel out/nhilos_pos_cuentas_espera_variantes.mp4",
    "build:owner": "remotion render src/index.ts OwnerDashboardReel out/nhilos_pos_owner_dashboard_navegacion_contextual.mp4",
    "build:square": "remotion render src/index.ts SocialSquare out/social-square.mp4",
    "generate:voiceover": "python3 scripts/generate-voiceover.py",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remotion": "^4.0.280",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.280",
    "@remotion/tailwind": "^4.0.280",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.9",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3"
  }
}
